<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KnowledgeMemory</AssemblyName>
    <RootNamespace>KnowledgeMemory.Host</RootNamespace>
    <Version>1.2.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is used only in the Tray folder; keep its types out of the global usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KnowledgeMemory.Core\KnowledgeMemory.Core.csproj" />
    <ProjectReference Include="..\KnowledgeMemory.Storage\KnowledgeMemory.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Tray "Instructions for the AI" copies this block; built in so it never depends on the docs folder. -->
    <EmbeddedResource Include="..\..\docs\agent-instructions.md" LogicalName="agent-instructions.md" />
  </ItemGroup>

</Project>
